// Don't forget to tell Prisma about your edits to this file using
// `yarn rw prisma migrate dev` or `yarn rw prisma db push`.
// `migrate` is like committing while `push` is for prototyping.
// Read more about both here:
// https://www.prisma.io/docs/orm/prisma-migrate

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

// Define your own datamodels here and run `yarn redwood prisma migrate dev`
// to create migrations for them and apply to your dev DB.
// TODO: Please remove the following example:
model UserExample {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

// User model for Admins/users
model User {
  id          Int      @id @default(autoincrement())
  name        String?
  email       String   @unique
  hashedPassword String
  salt        String
  resetToken        String?   @unique
  resetTokenExpiresAt DateTime?
  roles       String   @default("user")
  invitedBy   Int?                                    // the user ID of the admin who invited them
  isInvited   Boolean   @default(false)
  inviteToken   String?  @unique
  inviteTokenExpiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  orderLogs   OrderLog[]
}


// Pizza model for adding an order
model Pizza {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  orders    Order[]
}


// Topping model to add on the Pizza
model Topping {
  id       Int              @id @default(autoincrement())
  name     String
  orders   OrderTopping[]
}


// Order model with the Pizza and corresponding Toppings
model Order {
  id         Int              @id @default(autoincrement())
  user       User             @relation(fields: [userId], references: [id])
  userId     Int
  pizza      Pizza            @relation(fields: [pizzaId], references: [id])
  pizzaId    Int
  createdAt  DateTime         @default(now())
  toppings   OrderTopping[]
}


model OrderTopping {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  topping    Topping  @relation(fields: [toppingId], references: [id])
  toppingId  Int
}


model OrderLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  timestamp        DateTime @default(now())
  toppingNames     String   

  encryptedEmail   String   
  encryptedName    String   

  @@index([userId])
}


